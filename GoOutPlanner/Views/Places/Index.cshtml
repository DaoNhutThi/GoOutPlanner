@model IEnumerable<GoOutPlanner.Models.Place>

<h2>Danh sách địa điểm</h2>

<a asp-action="Create" class="btn btn-primary">
    Thêm địa điểm
</a>

<table class="table">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Loại</th>
            <th>Địa chỉ</th>
            <th>Rating</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Category</td>
                <td>@item.Address</td>
                <td>@item.Rating</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">Edit</a>

                    |

                    <a asp-action="Details"
                       asp-route-id="@item.Id">Details</a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>