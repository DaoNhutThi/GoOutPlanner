@model List<GoOutPlanner.Models.Place>

<h2>Danh sách địa điểm</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Loại</th>
            <th>Địa chỉ</th>
            <th>Đánh giá</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.Address</td>
                    <td>@item.Rating</td>
                </tr>
            }
        }
    </tbody>
</table>