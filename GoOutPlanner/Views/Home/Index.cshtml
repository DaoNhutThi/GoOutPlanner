@model IEnumerable<GoOutPlanner.Models.Place>

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>🍜 Hôm nay đi đâu?</h2>

        <a asp-controller="Places" asp-action="Create" class="btn btn-success">
            + Thêm địa điểm
        </a>
      

    </div>

    <!-- SEARCH -->
    <form method="get" class="mb-3">
        <div class="input-group">

            <input name="search"
                   class="form-control"
                   placeholder="Tìm món ăn / địa điểm..." />

            <button class="btn btn-primary">
                Search
            </button>

        </div>
    </form>

    <!-- LIST -->
<h2>Danh sách địa điểm</h2>

<a asp-action="Create" class="btn btn-primary">
    Thêm địa điểm
</a>

<table class="table">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Loại</th>
            <th>Địa chỉ</th>
            <th>Rating</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
            @if (Model != null)
            {
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Category</td>
                <td>@item.Address</td>
                <td>@item.Rating</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">Edit</a>

                    |

                    <a asp-action="Details"
                       asp-route-id="@item.Id">Details</a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }}
    </tbody>
</table>
</div>